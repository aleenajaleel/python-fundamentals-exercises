#4. Mobile Recharge Calculator
#Accept recharge amount and GST percentage. Calculate the GST and final amount.

recharge=int(input("enter the recharge amount"))
gst=int(input("enter the gst percentage"))
gst_amount=(recharge*gst)/100
final_amount=recharge+gst_amount
print("gst amount is :",gst_amount)
print("final amount is :",final_amount)

